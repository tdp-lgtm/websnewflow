---
import Base from '../layouts/Base.astro';
import { isPublished, flattenPresentations, presentationMark } from '../lib/content';
import talksData from '../../data/talks.json';

// One row per presentation — place, date, and invited/peer-reviewed marker.
// Titles are deliberately omitted; the layout mirrors the publications list.
const talks = (talksData.items || (talksData as any)).filter(isPublished);
const rows = flattenPresentations(talks);
---

<Base title="Talks — Jonas Haeg" description="Talks and conference presentations by Jonas Haeg." page="talks">
  <span class="eyebrow">Talks</span>
  <p class="talks-legend"><sup>*</sup> invited &ensp; <sup>&dagger;</sup> peer-reviewed</p>

  <ul class="pub-list">
    {rows.map(r => {
      const mark = presentationMark(r.type);
      return (
        <li class="pub">
          <div class="yr">{r.date}</div>
          <div class="talk-entry">
            {r.where}{mark && <sup class="talk-tag">{mark}</sup>}
            {r.comment && <em class="talk-comment"> {r.comment}</em>}
          </div>
        </li>
      );
    })}
  </ul>
</Base>
