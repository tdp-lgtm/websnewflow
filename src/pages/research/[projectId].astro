---
import Base from '../../layouts/Base.astro';
import { prepHtml } from '../../lib/prepHtml';
import { isPublished, validSlugs } from '../../lib/content';
import projectsData from '../../../data/projects.json';

export async function getStaticPaths() {
  const items = (((projectsData as any).items || []) as any[]).filter(isPublished);
  // "projects" is taken by the Projects listing page (research/projects.astro).
  return validSlugs(items).filter(p => {
    if (p.id === 'projects') console.warn('[build] project id "projects" is reserved for the Projects page; rename it.');
    return p.id !== 'projects';
  }).map(p => ({
    params: { projectId: p.id },
    props: { project: p },
  }));
}

const { project: p } = Astro.props;

const descHtml = p.description ? prepHtml(p.description) : '';
const links = (p.links || []).filter((l: any) => l && l.url);
const metaDesc = p.subtitle
  ? `${p.title} — ${p.subtitle}`
  : `${p.title} — a research project by Jonas Haeg.`;
---

<Base title={`${p.title} — Jonas Haeg`} description={metaDesc} page="research" heading={p.title} ogType="article" ownHeading>
  <h1 class="page-title">{p.title}</h1>

  {p.subtitle && <p class="section-subtitle">{p.subtitle}</p>}

  {descHtml && (
    <div
      class="workshop-description"
      style={p.justify ? 'text-align:justify' : undefined}
      set:html={descHtml}
    />
  )}

  {links.length > 0 && (
    <div class="pub-links project-links">
      {links.map((l: any) => (
        <a href={l.url} target="_blank" rel="noopener">{l.label || l.url}</a>
      ))}
    </div>
  )}
</Base>
